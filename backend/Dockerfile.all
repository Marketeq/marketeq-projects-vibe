FROM node:20-alpine AS builder
WORKDIR /app

COPY . .
RUN find . -name '*.tsbuildinfo' -delete && rm -rf dist
RUN npm ci --include=dev --legacy-peer-deps

# listings-service is 15K lines / 187 files — needs more heap than default.
# Explicitly give it 1GB to ensure it completes on the build runner.
RUN node --max-old-space-size=1024 ./node_modules/.bin/nest build listings-service

RUN npm prune --production --legacy-peer-deps

FROM node:20-alpine
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/boot-all.js ./boot-all.js
COPY --from=builder /app/libs/owner-target-grpc/proto ./libs/owner-target-grpc/proto
EXPOSE 10000
CMD ["node", "boot-all.js"]
