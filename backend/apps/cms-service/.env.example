# ── Payload core ──────────────────────────────────────────────────────────────
PAYLOAD_SECRET=replace-with-32-plus-char-random-string
DATABASE_URI=postgres://user:pass@host:5432/marketeq
# Payload writes to its own dedicated schema so it never collides with TypeORM
# tables managed by the NestJS services.
DATABASE_SCHEMA=cms

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3020
CMS_SERVER_URL=http://localhost:3020
NEXT_PUBLIC_SERVER_URL=http://localhost:3020

# ── Internal API key — used by other microservices for read-only CMS calls ──
CMS_API_KEY=cms-internal-key

# ── First-boot admin (delete after first login) ──────────────────────────────
CMS_ADMIN_EMAIL=admin@marketeq.com
CMS_ADMIN_PASSWORD=ChangeMe123!

# ── RabbitMQ — CmsEventPublisher fans out content events to consumer services
RABBITMQ_URL=amqp://user:pass@rabbitmq:5672
CMS_EVENTS_EXCHANGE=cms.events

# ── Sibling services (used for cold-start sync requests) ────────────────────
CATEGORY_SERVICE_URL=http://category-service:3025
LISTINGS_SERVICE_URL=http://listings-service:3001
CMS_SYNC_SECRET=replace-with-shared-bearer-secret

# ── Cloudflare R2 (S3-compatible) — used by @payloadcms/storage-s3 ──────────
# In Payload v3 the R2 plugin doesn't exist; we use the S3 adapter pointed at
# R2's S3 endpoint. Same bucket the rest of the platform uses for media.
R2_BUCKET=marketeq-cms
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
