{
  "info": {
    "_postman_id": "ps07-pricing-service-collection",
    "name": "Pricing Service Collection",
    "description": "PS-07 — QA & Test Data. Run the seed script before executing any request. Flush Redis before stale/no_data tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3016",
      "type": "string"
    },
    {
      "key": "internalJwt",
      "value": "",
      "description": "Valid JWT from auth-service. Obtain from auth-service login endpoint.",
      "type": "string"
    },
    {
      "key": "freshRole",
      "value": "UX Designer",
      "description": "Role title with a fresh seed record.",
      "type": "string"
    },
    {
      "key": "staleRole",
      "value": "DevOps Engineer",
      "description": "Role title with a stale seed record (lastUpdated 48h ago).",
      "type": "string"
    },
    {
      "key": "noDataRole",
      "value": "Quantum Architect",
      "description": "Role title with no seed record.",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Rates",
      "item": [
        {
          "name": "TC-RATE-01 — GET Rates — fresh data (all four params)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/rates?role={{freshRole}}&location=United+States&experience=mid&schedule=full_time",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "rates"],
              "query": [
                { "key": "role", "value": "{{freshRole}}" },
                { "key": "location", "value": "United+States" },
                { "key": "experience", "value": "mid" },
                { "key": "schedule", "value": "full_time" }
              ]
            },
            "description": "TC-RATE-01. Expects 200. hourlyMedianUsdCents:10000, hourlyLowUsdCents:7500, hourlyHighUsdCents:13500, is_stale:false, no_data:false, sampleSize:142."
          }
        },
        {
          "name": "TC-RATE-02 — GET Rates — cache hit on second request",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/rates?role={{freshRole}}&location=United+States&experience=mid&schedule=full_time",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "rates"],
              "query": [
                { "key": "role", "value": "{{freshRole}}" },
                { "key": "location", "value": "United+States" },
                { "key": "experience", "value": "mid" },
                { "key": "schedule", "value": "full_time" }
              ]
            },
            "description": "TC-RATE-02. Run immediately after TC-RATE-01. Expects 200. cache_hit:true. Values identical to first response."
          }
        },
        {
          "name": "TC-RATE-03 — GET Rates — no location filter",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/rates?role={{freshRole}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "rates"],
              "query": [
                { "key": "role", "value": "{{freshRole}}" }
              ]
            },
            "description": "TC-RATE-03. Expects 200. Returns global average or nearest match. no_data:false."
          }
        },
        {
          "name": "TC-RATE-07 — GET Rates — stale record",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/rates?role={{staleRole}}&location=Southeast+Asia&experience=mid&schedule=full_time",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "rates"],
              "query": [
                { "key": "role", "value": "{{staleRole}}" },
                { "key": "location", "value": "Southeast+Asia" },
                { "key": "experience", "value": "mid" },
                { "key": "schedule", "value": "full_time" }
              ]
            },
            "description": "TC-RATE-07. Flush Redis first. Expects 200. is_stale:true. stale_since populated. Rate values present. no_data:false."
          }
        },
        {
          "name": "TC-RATE-06 — GET Rates — no data (unknown combination)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/rates?role={{noDataRole}}&location=Antarctica",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "rates"],
              "query": [
                { "key": "role", "value": "{{noDataRole}}" },
                { "key": "location", "value": "Antarctica" }
              ]
            },
            "description": "TC-RATE-06. Expects 200. no_data:true. All rate fields null. is_stale:false."
          }
        },
        {
          "name": "TC-RATE-08 — GET Rates — missing role param [expect 422]",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/rates",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "rates"]
            },
            "description": "TC-RATE-08. Expects 422. PS_VALIDATION_ERROR. role is required."
          }
        },
        {
          "name": "TC-RATE-09 — GET Rates — invalid experience value [expect 422]",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/rates?role={{freshRole}}&experience=expert",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "rates"],
              "query": [
                { "key": "role", "value": "{{freshRole}}" },
                { "key": "experience", "value": "expert" }
              ]
            },
            "description": "TC-RATE-09. Expects 422. PS_VALIDATION_ERROR. experience must be junior, mid, or senior."
          }
        },
        {
          "name": "TC-RATE-10 — GET Rates — invalid schedule value [expect 422]",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/rates?role={{freshRole}}&schedule=occasional",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "rates"],
              "query": [
                { "key": "role", "value": "{{freshRole}}" },
                { "key": "schedule", "value": "occasional" }
              ]
            },
            "description": "TC-RATE-10. Expects 422. PS_VALIDATION_ERROR. schedule must be full_time, part_time, or custom."
          }
        },
        {
          "name": "TC-RATE-11 — GET Rates — unauthenticated [expect 401]",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/rates?role={{freshRole}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "rates"],
              "query": [
                { "key": "role", "value": "{{freshRole}}" }
              ]
            },
            "description": "TC-RATE-11. No JWT header. Expects 401. PS_UNAUTHORIZED."
          }
        }
      ]
    },
    {
      "name": "Price Guide",
      "item": [
        {
          "name": "TC-PG-01 — GET Price Guide — all three tiers present",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" }
            ],
            "url": {
