{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2017",
    "sourceMap": true,
    "outDir": "../../dist/apps/api-gateway",
    "baseUrl": "./",
    "paths": {
      "@libs/*": ["../../libs/*/src"]
    },
    "incremental": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "../../libs/**/*"
  ],
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}
