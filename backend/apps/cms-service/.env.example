# ── CMS Service ──
CMS_PORT=3020
CMS_SERVER_URL=http://cms-service:3020

# ── Database (Supabase PostgreSQL) ──
DATABASE_URL=postgresql://user:pass@localhost:5432/marketeq?schema=cms

# ── Payload Secret (32+ chars) ──
PAYLOAD_SECRET=change-me-to-a-long-random-string

# ── API Key for service-to-service reads ──
CMS_API_KEY=change-me

# ── Category Service ──
CATEGORY_SERVICE_URL=http://category-service:3025
CMS_SYNC_SECRET=change-me

# ── RabbitMQ ──
RABBITMQ_URL=amqp://user:pass@rabbitmq:5672

# ── Cloudflare R2 Storage ──
R2_BUCKET=marketeq-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ── First-run admin (remove after first login) ──
# CMS_ADMIN_EMAIL=admin@marketeq.com
# CMS_ADMIN_PASSWORD=change-me

# ── Logging ──
LOG_LEVEL=info
