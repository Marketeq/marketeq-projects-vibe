# ============================================================================
# Marketeq Frontend Environment Variables
# ============================================================================
# Copy to .env.local for local development.
# For Vercel: set these in Project Settings → Environment Variables.
#
# IMPORTANT: The build will FAIL on Vercel if any *_URL var contains
# "localhost". See scripts/validate-env.js for details.
# ============================================================================

# Environment identifier — "development" skips env validation
NEXT_PUBLIC_ENV=development

# ── Required API URLs (build will fail if missing on Vercel) ────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_URL=http://localhost:4000
NEXT_PUBLIC_USER_URL=http://localhost:4000

# ── Optional API URLs (used by specific features) ──────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_FAVORITES_API_URL=http://localhost:4000/favorites
NEXT_PUBLIC_SEMANTIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CONTRACTS_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Listings-service base (publish project flow). Falls back to
# NEXT_PUBLIC_API_URL → NEXT_PUBLIC_AUTH_URL if unset.
NEXT_PUBLIC_LISTINGS_URL=http://localhost:4000

# ── Payments ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── OAuth ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_SECRET=
NEXT_PUBLIC_PAYOUT_SERVICE_URL=http://localhost:3022/v1

NEXT_PUBLIC_API_BASE_URL=https://projects.marketeqdigital.com
NEXT_PUBLIC_ENV=development
