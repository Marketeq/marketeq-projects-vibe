# Database — shared Supabase PostgreSQL (legal schema)
DATABASE_URL=postgres://user:pass@localhost:5432/marketeq

# HTTP Server
PORT=3032

# Node environment
NODE_ENV=development

# JWT
JWT_SECRET=local_dev_secret
AUTH_JWT_PUBLIC_KEY=

# RabbitMQ
RABBITMQ_URL=amqp://user:pass@localhost:5672

# Cloudflare R2 Storage
# IMPORTANT: endpoint is the account-level URL only — do NOT append the bucket name.
# Correct format: https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=marketeq-legal
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_PRESIGN_TTL_SECONDS=3600

# External Services
USER_SERVICE_URL=http://user-service:3002

# Frontend
FE_ORIGIN=http://localhost:3000

# Name Matching Thresholds
NAME_MATCH_EXACT_THRESHOLD=1.0
NAME_MATCH_VARIATION_THRESHOLD=0.85

# NDA Configuration
NDA_TEMPLATE_VERSION=1.0.0

# Machine-to-machine secret (listings-service → legal-service)
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=change-me-internal-secret

# Admin dashboard token (support/compliance tools → legal-service)
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=change-me-admin-token
