FROM node:20-alpine AS builder
WORKDIR /app

COPY . .
RUN find . -name '*.tsbuildinfo' -delete && rm -rf dist
RUN npm ci --include=dev --legacy-peer-deps

# Test: build admin-service (fails first in alphabetical 27-service builds)
RUN npx nest build admin-service \
 && echo "[build] admin-service OK" \
 && npx nest build api-gateway \
 && echo "[build] api-gateway OK" \
 && npx nest build auth-service \
 && echo "[build] auth-service OK"

RUN npm prune --production --legacy-peer-deps

FROM node:20-alpine
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/boot-all.js ./boot-all.js
COPY --from=builder /app/libs/owner-target-grpc/proto ./libs/owner-target-grpc/proto
EXPOSE 10000
CMD ["node", "boot-all.js"]
