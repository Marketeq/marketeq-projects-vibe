# ============================================================================
# Marketeq Backend — STAGING environment template
# ============================================================================
# Per DEVOPS_SOP §5, this template is FROZEN. Changes require a PR
# targeting `staging` with the staging four-point login confirmation.
# Note: per DEVOPS_SOP §3, the shared Render backend is deployed from
# `live-mvp`, not `staging`. This template documents the staging-facing
# values the shared backend must honor while the staging frontend
# (`marketeq-projects-staging`) talks to the same Render instance as
# production.
# ============================================================================

NODE_ENV=production
APP_ENV=staging
PORT=3002

# --- CORS ---
# Staging frontend (Vercel preview) origin. Must be exact — no wildcards.
CORS_ORIGIN=https://staging.marketeq.com
CORS_CREDENTIALS=true

# --- Cookies ---
# HTTPS production-grade cookies.
COOKIE_DOMAIN=.marketeq-staging.com
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# --- JWT ---
JWT_ISSUER=marketeq-staging
JWT_AUDIENCE=marketeq-staging
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
# JWT_PRIVATE_KEY / JWT_PUBLIC_KEY are set in Render env vars. Never
# commit the key material.

# --- Database ---
DATABASE_URL=
DATABASE_SSL=false

# --- RabbitMQ ---
RABBITMQ_URL=

# --- Auth transactional email ---
BREVO_API_KEY=
BREVO_FROM_EMAIL=support@marketeqdigital.com
BREVO_FROM_NAME=Marketeq Projects
BREVO_PASSWORD_RESET_TEMPLATE_ID=
BREVO_PASSWORD_CREATED_TEMPLATE_ID=
PASSWORD_CREATED_LOGIN_URL=https://staging.marketeq.com/login

# --- Storage (R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=marketeq-staging
R2_CDN_BASE=https://cdn.marketeq.com

# --- Payments: Stripe ---
# Names only — values live in Render env vars / the marketeq-secrets group.
# Read by billing-service (stripe-subscription.service.ts),
# checkout-service (stripe/stripe.service.ts) and payout-service
# (bank/bank-payout-executor.service.ts, providers/stripe.provider.ts).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Payments: PayPal ---
# Read by payout-service (oauth/oauth.service.ts,
# providers/paypal.provider.ts, paypal/paypal-reconciliation.cron.ts).
# PAYPAL_REDIRECT_URI must exactly match the redirect registered on the
# PayPal app; it is `<backend origin>/v1/oauth/paypal/callback`. When it is
# unset, oauth.service.ts silently defaults it to '' and PayPal OAuth fails
# with no error naming the cause.
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_REDIRECT_URI=
PAYPAL_SCOPES=openid email
PAYPAL_WEBHOOK_ID=
