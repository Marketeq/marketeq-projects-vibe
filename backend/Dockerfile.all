FROM node:20-alpine AS builder
WORKDIR /app

# Copy everything (workspace structure needed for npm install + nest build)
COPY . .

# Guard against stale incremental metadata during Render rebuilds.
RUN find . -name '*.tsbuildinfo' -delete && rm -rf dist

# Install ALL deps including devDependencies (need @nestjs/cli for build)
RUN npm ci --include=dev --legacy-peer-deps

# Build all 27 services with constrained Node heap (build plan has limited RAM).
# Each service runs in its own node process via &&, keeping heap per-compile.
# NODE_OPTIONS caps the TypeScript compiler to avoid OOM on the build runner.
ENV NODE_OPTIONS="--max-old-space-size=256"

# Batch 1: A services
RUN npx nest build admin-service \
 && npx nest build affiliate-referral-service \
 && npx nest build algolia-service \
 && npx nest build api-gateway \
 && npx nest build auth-service \
 && npx nest build autocomplete-service

# Batch 2: B-E services
RUN npx nest build billing-service \
 && npx nest build category-service \
 && npx nest build checkout-service \
 && npx nest build content-moderation-service \
 && npx nest build contracts-service \
 && npx nest build earnings-service

# Batch 3: F-N services
RUN npx nest build favorites-service \
 && npx nest build invitations-service \
 && npx nest build listings-service \
 && npx nest build messaging-service \
 && npx nest build notification-service

# Batch 4: P-S services
RUN npx nest build payout-service \
 && npx nest build portfolio-service \
 && npx nest build pricing-service \
 && npx nest build search-service \
 && npx nest build suggestions-service

# Batch 5: T-W services
RUN npx nest build time-tracking-service \
 && npx nest build transaction-service \
 && npx nest build user-service \
 && npx nest build wallet-service \
 && npx nest build wire-review-service

# Clear the build-time heap cap so it doesn't affect runtime
ENV NODE_OPTIONS=""

# Prune devDependencies for smaller production image
RUN npm prune --production --legacy-peer-deps

# ── Production image ────────────────────────────────────────────────────────
FROM node:20-alpine
WORKDIR /app

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/boot-all.js ./boot-all.js
COPY --from=builder /app/libs/owner-target-grpc/proto ./libs/owner-target-grpc/proto

EXPOSE 10000
CMD ["node", "boot-all.js"]
