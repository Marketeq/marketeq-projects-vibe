              { "key": "x-internal-api-secret", "value": "{{internalSecret}}" },
              { "key": "x-user-id", "value": "{{talentAId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 422', () => pm.response.to.have.status(422));"
          ]}}]
        },
        {
          "name": "TC-ACC-07 Two versions — both accepted [expect 201 x2]",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/acceptance/terms-of-service",
            "header": [
              { "key": "x-internal-api-secret", "value": "{{internalSecret}}" },
              { "key": "x-user-id", "value": "{{talentBId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"documentVersion\": \"3.3\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('version 3.3', () => pm.expect(pm.response.json().documentVersion).to.eql('3.3'));"
          ]}}]
        }
      ]
    },

