# user-service local environment
#
# Copy this file to `.env` inside backend/apps/user-service and fill in the
# values. The service also reads backend/.env if a value is missing here.

PORT=3002

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketeq_user

# CORS origin for the frontend (gateway is typically http://localhost:4000)
FE_ORIGIN=http://localhost:3000

# -------------------------------------------------------------------
# Cloudflare R2 (object storage for avatars, uploaded via POST /user/me/avatar)
# -------------------------------------------------------------------
# These are the variable names that backend/apps/user-service/src/storage/
# r2.service.ts actually reads. If any of these are missing, the avatar
# upload endpoint logs a warning and returns `{ url: null }`, and onboarding
# proceeds without setting an avatar.
#
# For local dev, concrete values (bucket name, account id, public URL host,
# access key, secret) are currently checked into backend/apps/user-service/
# seed-users.js (see lines 200, 250-253). Copy them from there if you need
# real uploads working locally. Those committed secrets should be rotated
# and removed from git — treat them as already-leaked.
#
# For a new Cloudflare account, follow the setup guide at:
#   docs/md/Listings Service/Projects/Publishing a Project/☁️ Cloudflare Media Storage Setup Guide.md

CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Optional: override the derived endpoint
# CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
