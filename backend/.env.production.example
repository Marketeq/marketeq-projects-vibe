# ============================================================================
# Marketeq Backend — PRODUCTION environment template
# ============================================================================
# Per DEVOPS_SOP §5, this template is FROZEN. Changes require a PR
# targeting `live-mvp` with the production four-point login
# confirmation. This template is the schema for the single Render
# service `marketeq-backend`, which auto-deploys on every
# live-mvp push (DEVOPS_SOP §3). Real values are set in Render env
# vars, never committed.
# ============================================================================

NODE_ENV=production
APP_ENV=production
PORT=3002

# --- CORS ---
CORS_ORIGIN=https://marketeq.com
CORS_CREDENTIALS=true

# --- Cookies ---
COOKIE_DOMAIN=.marketeq.com
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# --- JWT ---
JWT_ISSUER=marketeq
JWT_AUDIENCE=marketeq
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# --- Database ---
DATABASE_URL=
DATABASE_SSL=false

# --- RabbitMQ ---
RABBITMQ_URL=

# --- Auth transactional email ---
BREVO_API_KEY=
BREVO_FROM_EMAIL=support@marketeqdigital.com
BREVO_FROM_NAME=Marketeq Projects
BREVO_PASSWORD_RESET_TEMPLATE_ID=
BREVO_PASSWORD_CREATED_TEMPLATE_ID=
PASSWORD_CREATED_LOGIN_URL=https://marketeq.com/login

# --- Storage (R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=marketeq-production
R2_CDN_BASE=https://cdn.marketeq.com

# USPS Addresses API (US billing address validation, Confirm Address pop-up).
# Create the app at developers.usps.com for the Consumer Key (client id) and Secret.
# Never commit a real secret. Base URL production: https://apis.usps.com
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
USPS_API_BASE_URL=https://apis.usps.com

# Melissa Global Address Verification (non-US billing address validation, Confirm Address pop-up).
# Get the License Key from your account page at apps.melissa.com (GAV Free plan: 250 records per month).
# Never commit a real key.
MELISSA_LICENSE_KEY=
MELISSA_API_BASE_URL=https://address.melissadata.net
