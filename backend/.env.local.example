# ============================================================================
# Marketeq Backend — LOCAL dev environment template
# ============================================================================
# Per DEVOPS_SOP §5, this template is FROZEN. Changes require a PR
# targeting `dev-main` with the four-point login confirmation from
# SOP §1.4. Modifying this file does not affect staging or production.
# Per DEVOPS_SOP §4, the committed template must point at localhost.
# ============================================================================

NODE_ENV=development
APP_ENV=local
PORT=3002

# --- CORS ---
# Local frontend origin only. Changing this is an DEVOPS_SOP §6 violation.
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# --- Cookies ---
COOKIE_DOMAIN=localhost
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# --- JWT ---
# Local dev uses a static dev key (NOT for production). The key material
# itself is NEVER committed — see SOP §8.2. Use a throwaway value here.
JWT_ISSUER=marketeq-local
JWT_AUDIENCE=marketeq-local
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
# Set JWT_PRIVATE_KEY / JWT_PUBLIC_KEY via your shell or a gitignored
# .env.local file. Never commit key material.

# --- Password reset anti-abuse limits ---
# In-memory per auth-service instance.
AUTH_FORGOT_PASSWORD_IP_LIMIT=10
AUTH_FORGOT_PASSWORD_EMAIL_LIMIT=3
AUTH_FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
AUTH_RESET_PASSWORD_IP_LIMIT=20
AUTH_RESET_PASSWORD_RATE_LIMIT_WINDOW_MS=900000

# --- Database (local Supabase or local Postgres) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketeq_local
DATABASE_SSL=false

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Inter-service URLs ---
# payout-service -> earnings-service (fresh balance reads for withdrawals),
# also read by api-gateway's proxy and time-tracking-service's earnings sync.
# Previously undocumented anywhere — all three call sites silently fell back
# to this same localhost:3026 default (ecosystem.config.js's earnings-service
# port). Works locally because every service is a separate PM2 process on
# the same machine; same is true on Render (one shared service, same
# topology) — only change this if earnings-service is ever split out.
EARNINGS_SERVICE_URL=http://localhost:3026

# --- Auth transactional email ---
# FRONTEND_URL is required to build the password-reset link sent via Brevo;
# without it, forgotPassword() silently skips sending the email.
FRONTEND_URL=http://localhost:3000
BREVO_API_KEY=
BREVO_FROM_EMAIL=support@marketeqdigital.com
BREVO_FROM_NAME=Marketeq Projects
BREVO_PASSWORD_RESET_TEMPLATE_ID=
BREVO_PASSWORD_CREATED_TEMPLATE_ID=
PASSWORD_CREATED_LOGIN_URL=http://localhost:3000/login

# --- Storage (R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=marketeq-dev
R2_CDN_BASE=https://cdn.marketeq.com

# Stripe Financial Connections (PS-05)
# Use sk_test_YOUR_KEY_HERE to run in mock/dev mode (no real Stripe calls)
# Replace with real sk_test_* key from Stripe dashboard for actual FC modal
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_FC_RETURN_URL=http://localhost:3000/deposit-methods/stripe/callback
# PS-33 §9: your platform's Stripe account ID (dashboard.stripe.com/settings/account).
# Not read by any code path yet — documented for when the platform-level
# reporting/reconciliation tooling needs it.
STRIPE_PLATFORM_ACCOUNT_ID=acct_your_platform_account_id
# PS-33 §9/§10: pin deliberately — update only after reading the Stripe API changelog.
STRIPE_API_VERSION=2024-06-20

# Payout Service — deposit method encryption, OAuth, crypto providers, email
# Encryption keys: generate with `openssl rand -hex 32` — must be 64 hex
# chars. Without a real value, payout-service now fails to start (previously
# fell back to a random key each restart, silently invalidating all
# already-encrypted bank/OAuth/crypto data — fixed).
BANK_ENCRYPTION_KEY=your_64_char_hex_key_here
OAUTH_TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here
CRYPTO_ADDRESS_ENCRYPTION_KEY=your_64_char_hex_key_here

# PS-13: Marketeq Debit Card (Stripe Issuing). Gates both card issuance and
# deposit-method creation — set to 'true' to enable.
FEATURE_DEBIT_CARD_ENABLED=false

# PS-35: Didit biometric verification gate (schedule creation + new payout
# methods). Defaults false — identity-verification-service doesn't implement
# the biometric endpoints yet; flipping this on before it does 503s every
# gated action (PS-35 §8 fails closed, never open).
FEATURE_BIOMETRIC_GATE_ENABLED=false

# Wise OAuth (sandbox.transferwise.tech developer account)
WISE_CLIENT_ID=your_wise_client_id
WISE_CLIENT_SECRET=your_wise_client_secret
WISE_REDIRECT_URI=http://localhost:3000/deposit-methods/wise/callback
# Sandbox base URL for local dev/staging; switch to https://api.transferwise.com
# in production only (PS-09 §3/§12.1).
WISE_API_BASE_URL=https://api.sandbox.transferwise.tech

# Payoneer OAuth (payoneer.com developer program)
PAYONEER_CLIENT_ID=your_payoneer_client_id
PAYONEER_CLIENT_SECRET=your_payoneer_client_secret
PAYONEER_REDIRECT_URI=http://localhost:3000/deposit-methods/payoneer/callback
# Sandbox base URL for local dev/staging; switch to https://api.payoneer.com
# in production only (PS-09 §3/§12.2).
PAYONEER_API_BASE_URL=https://api.sandbox.payoneer.com

# TTL in seconds for the OAuth state nonce stored in Redis (PS-09 §3)
OAUTH_STATE_TTL_SECONDS=600

# SendGrid — magic-link withdrawal confirmation emails. Without a real key
# (or if it starts with "SG.your_"), the verify URL is logged to the
# console instead of being emailed.
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Crypto on/off-ramp providers (only needed if crypto deposit methods matter)
# RAMP_API_KEY doubles as Ramp's "hostApiKey" — a public widget identifier,
# not a server-side secret (Ramp Network has no self-serve server-to-server
# payout API; real credentials come from partner@ramp.network).
RAMP_API_KEY=your_ramp_api_key
RAMP_WEBHOOK_SECRET=your_ramp_webhook_secret
RAMP_WIDGET_BASE=https://app.demo.ramp.network
TRANSAK_API_KEY=your_transak_api_key
CRYPTO_COM_API_KEY=your_crypto_com_api_key
COINBASE_COMMERCE_API_KEY=your_coinbase_commerce_api_key
