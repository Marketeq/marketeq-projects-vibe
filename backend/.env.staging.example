# ============================================================================
# Marketeq Backend — STAGING environment template
# ============================================================================
# Per DEVOPS_SOP §5, this template is FROZEN. Changes require a PR
# targeting `staging` with the staging four-point login confirmation.
# Note: per DEVOPS_SOP §3, the shared Render backend is deployed from
# `live-mvp`, not `staging`. This template documents the staging-facing
# values the shared backend must honor while the staging frontend
# (`marketeq-projects-staging`) talks to the same Render instance as
# production.
# ============================================================================

NODE_ENV=production
APP_ENV=staging
PORT=3002

# --- CORS ---
# Staging frontend (Vercel preview) origin. Must be exact — no wildcards.
CORS_ORIGIN=https://staging.marketeq.com
CORS_CREDENTIALS=true

# FRONTEND_URL — comma-separated trusted origins (same convention as
# auth-service's password-reset flow; payout-service's magic-link email
# uses this the same way). Since marketeq-backend is ONE shared Render
# service serving dev + staging + live at once (DEVOPS_SOP.md §3), the
# REAL value configured on that service already contains the full union of
# all Vercel origins (see scripts/devops/marketeq_orchestrator_node.js's
# RENDER_SHARED_BACKEND_BASELINE) — this template documents staging's own
# contribution to that list, not a value to overwrite it with.
FRONTEND_URL=https://staging.marketeq.com

# --- Cookies ---
# HTTPS production-grade cookies.
COOKIE_DOMAIN=.marketeq-staging.com
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# --- JWT ---
JWT_ISSUER=marketeq-staging
JWT_AUDIENCE=marketeq-staging
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
# JWT_PRIVATE_KEY / JWT_PUBLIC_KEY are set in Render env vars. Never
# commit the key material.

# --- Database ---
DATABASE_URL=
DATABASE_SSL=false

# --- RabbitMQ ---
RABBITMQ_URL=

# --- Inter-service URLs ---
# payout-service -> earnings-service (fresh balance reads for withdrawals),
# also read by api-gateway's proxy and time-tracking-service's earnings sync.
# NOT the same port as local dev: ecosystem.config.js (local PM2) assigns
# earnings-service:3026/billing-service:3027, but boot-all.js (the shared
# Render service) assigns them the other way around — earnings-service:3027,
# billing-service:3026. Copying the local value here silently points
# payout-service's pre-withdrawal balance read (and the scheduled payout
# engine's balance check) at billing-service instead.
EARNINGS_SERVICE_URL=http://localhost:3027

# --- Auth transactional email ---
BREVO_API_KEY=
BREVO_FROM_EMAIL=support@marketeqdigital.com
BREVO_FROM_NAME=Marketeq Projects
BREVO_PASSWORD_RESET_TEMPLATE_ID=
BREVO_PASSWORD_CREATED_TEMPLATE_ID=
PASSWORD_CREATED_LOGIN_URL=https://staging.marketeq.com/login

# --- Storage (R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=marketeq-staging
R2_CDN_BASE=https://cdn.marketeq.com

# --- Payments: Stripe ---
# Names only — values live in Render env vars / the marketeq-secrets group.
# Read by billing-service (stripe-subscription.service.ts),
# checkout-service (stripe/stripe.service.ts) and payout-service
# (bank/bank-payout-executor.service.ts, providers/stripe.provider.ts).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Payments: PayPal ---
# Read by payout-service (oauth/oauth.service.ts,
# providers/paypal.provider.ts, paypal/paypal-reconciliation.cron.ts).
# PAYPAL_REDIRECT_URI must exactly match the redirect registered on the
# PayPal app; it is `<backend origin>/v1/oauth/paypal/callback`. When it is
# unset, oauth.service.ts silently defaults it to '' and PayPal OAuth fails
# with no error naming the cause.
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_REDIRECT_URI=
PAYPAL_SCOPES=openid email
PAYPAL_WEBHOOK_ID=

# --- Account Recovery + Settings (PR #737) ---
# Added with the Account Recovery / Settings work. Every variable below is
# read by code that is now on this branch; before #737 none of them existed,
# which is why none were declared here.
#
# REQUIRED — the feature returns 500 without it. auth.service.ts:2690 reads
# this and throws InternalServerErrorException('TWO_FACTOR_ENCRYPTION_KEY is
# required') when it is unset, so POST /auth/2fa/generate fails and the
# Settings App Authenticator dialog cannot complete setup. It is NOT in
# boot-all.js's baseline and NOT in the orchestrator's
# RENDER_SHARED_BACKEND_BASELINE, so it has to be set on the Render service
# by hand. Generate with `openssl rand -hex 32`. Changing it after accounts
# have enrolled invalidates every stored 2FA secret — the value is used as
# scrypt input, not stored alongside the data.
TWO_FACTOR_ENCRYPTION_KEY=

# Brevo template ids for the two emails #737 introduced. brevo.service.ts
# reads each with `raw ? Number(raw) : undefined`, so an unset value is not
# an error — the send is simply attempted without a template. Set both, or
# the recovery-email confirmation and password-changed notices go out
# wrong. Note the existing Brevo trap: the account's authorised-IP list
# holds IPv4 only, and a host that egresses IPv6 gets
# `401 unrecognised IP address`, which auth-service swallows — the API
# still returns 200 and nothing is delivered. Render's egress addresses
# must be on the allowlist.
BREVO_RECOVERY_EMAIL_TEMPLATE_ID=
BREVO_PASSWORD_CHANGED_TEMPLATE_ID=

# --- Optional: these have in-code defaults, documented so they are findable ---
# Contact Support destination. support.service.ts:33 falls back to
# BREVO_FROM_EMAIL and then to support@marketeqdigital.com, so leaving it
# empty is safe.
SUPPORT_INBOX_EMAIL=
# Contact Support throttle. Defaults to 5 submissions per 15 minutes
# (support.service.ts:49-53). In-memory, so a restart clears the bucket.
SUPPORT_RATE_LIMIT=
SUPPORT_RATE_LIMIT_WINDOW_MS=
# Lifetime of the reset token issued after a successful recovery challenge.
# Defaults to 15m (auth.service.ts:1326).
AUTH_RECOVERY_RESET_TOKEN_EXPIRES_IN=

# USPS Addresses API (US billing address validation, Confirm Address pop-up).
# Create the app at developers.usps.com for the Consumer Key (client id) and Secret.
# Never commit a real secret. Base URL production: https://apis.usps.com
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
USPS_API_BASE_URL=https://apis.usps.com

# Melissa Global Address Verification (non-US billing address validation, Confirm Address pop-up).
# Get the License Key from your account page at apps.melissa.com (GAV Free plan: 250 records per month).
# Never commit a real key.
MELISSA_LICENSE_KEY=
MELISSA_API_BASE_URL=https://address.melissadata.net
