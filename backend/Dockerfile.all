FROM node:20-alpine AS builder
WORKDIR /app

COPY . .
RUN find . -name '*.tsbuildinfo' -delete && rm -rf dist
RUN npm ci --include=dev --legacy-peer-deps

# Test: build listings-service with explicit Node heap limit
# Render Starter build runner may have limited RAM
RUN NODE_OPTIONS="--max-old-space-size=400" npx nest build listings-service

RUN npm prune --production --legacy-peer-deps

FROM node:20-alpine
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/boot-all.js ./boot-all.js
COPY --from=builder /app/libs/owner-target-grpc/proto ./libs/owner-target-grpc/proto
EXPOSE 10000
CMD ["node", "boot-all.js"]
