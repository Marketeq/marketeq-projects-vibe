# apps/category-service/.env.example
#
# This file lists environment variables used by `apps/category-service`.
# Copy to `.env` and fill in values for your environment.
#

# -----------------------------
# Database (TypeORM / Postgres)
# -----------------------------
DATABASE_TYPE=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/category_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=category_db

# If true, TypeORM auto-syncs schema (recommended false outside local dev)
DATABASE_SYNCHRONIZE=false

# Optional: log SQL queries (1 = on, 0 = off)
DATABASE_LOG_QUERIES=0

# SSL for managed Postgres
DATABASE_SSL_ENABLED=false

# -----------------------------
# App
# -----------------------------
NODE_ENV=development
PORT=3014

# Present in repo `.env` files (not all may be used directly by this app)
APP_NAME=
API_PREFIX=
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
INTERNAL_SERVICE_TOKEN=dev-internal-token
FE_ORIGIN=http://localhost:3000

# Canonical base for category page SEO (falls back to FE_ORIGIN if unset)
# PUBLIC_SITE_ORIGIN=https://www.example.com

# Preview (Endpoint Catalog): ?preview=1 alone shows unpublished/draft category pages.
# Optional hardening: if set, clients must send header x-preview-token: <same value> with ?preview=1
# PREVIEW_TOKEN=

# -----------------------------
# CMS Service (Payload CMS)
# -----------------------------
CMS_SERVICE_URL=http://localhost:3020
CMS_API_KEY=

# -----------------------------
# RabbitMQ (category event consumer)
# -----------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# -----------------------------
# Category logic / fallbacks
# -----------------------------
# Optional: used when the service needs a fallback parent UUID
FALLBACK_PARENT_UUID=

# Grid: HTTP query `limit` = rows per block; multiply by cards per row for adapter fetch size
CATEGORY_PAGE_CARDS_PER_ROW=4

# Optional: UserAdapterReal calls this if set; otherwise uses deterministic mock talent
TALENT_API_URL=

# -----------------------------
# Category Pages health thresholds (optional)
# -----------------------------
PAGE_HEALTH_MIN_GRID_ROWS=2
PAGE_HEALTH_MIN_CAROUSEL_PAGES=3

