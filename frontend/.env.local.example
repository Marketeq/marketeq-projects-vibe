# ============================================================================
# Marketeq Frontend — LOCAL dev environment template
# ============================================================================
# This file is the ONLY source of truth for env vars on a developer's
# laptop. Copy to `frontend/.env.local` and fill in the blanks.
#
# Per Code Review SOP §1.10, this template is FROZEN. Changes require a
# PR targeting `dev-main` with the four-point login confirmation from
# SOP §1.8. Modifying this file does not affect staging or production.
#
# DO NOT add Render URLs here. Per SOP §1.9, local dev must be fully
# detached from Render. Backend targets must point at localhost.
# ============================================================================

# --- Backend target ---
# Local NestJS backend. Boot with: pnpm --filter backend start:dev
NEXT_PUBLIC_BACKEND_URL=http://localhost:3002/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002/api
NEXT_PUBLIC_WS_URL=http://localhost:3002

# --- Auth / session behavior ---
# Local dev uses SameSite=Lax and Secure=false because localhost is not HTTPS.
# Changing these flags is an automatic SOP §1.10 violation.
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_COOKIE_SAMESITE=lax
NEXT_PUBLIC_COOKIE_SECURE=false
NEXT_PUBLIC_COOKIE_DOMAIN=localhost

# --- OAuth callback URLs (local) ---
NEXT_PUBLIC_GOOGLE_OAUTH_REDIRECT=http://localhost:3000/auth/google/callback
NEXT_PUBLIC_LINKEDIN_OAUTH_REDIRECT=http://localhost:3000/auth/linkedin/callback

# --- Feature flags (local defaults) ---
NEXT_PUBLIC_ENABLE_DEV_LOGIN_BYPASS=false
NEXT_PUBLIC_ENABLE_DEBUG_PANELS=true

# --- Storage (Cloudflare R2) — same for all envs, read by signed URL service ---
NEXT_PUBLIC_R2_CDN_BASE=https://cdn.marketeq.com
