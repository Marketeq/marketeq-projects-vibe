# ============================================================================
# Marketeq Frontend — STAGING environment template
# ============================================================================
# This file is the schema for the Vercel `marketeq-projects-staging`
# project. The real values are set in Vercel's dashboard under
# "Production" (tracking the `staging` branch) environment variables.
# Per DEVOPS_SOP §2/§3, staging uses the shared Render backend
# (`marketeq-backend`). QA tests the staging frontend against that
# service before promoting to live-mvp.
#
# Per DEVOPS_SOP §5 this template is FROZEN. Changes require a PR
# targeting the `staging` branch with the staging four-point
# confirmation in the PR description. Modifying this file does not
# affect local or production.
# ============================================================================

# --- Backend target ---
# Shared Render service. Real URL is set in Vercel.
NEXT_PUBLIC_BACKEND_URL=https://marketeq-backend.onrender.com/api
NEXT_PUBLIC_API_BASE_URL=https://marketeq-backend.onrender.com/api
NEXT_PUBLIC_API_URL=https://marketeq-backend.onrender.com/api
NEXT_PUBLIC_AUTH_URL=https://marketeq-backend.onrender.com/api
NEXT_PUBLIC_USER_URL=https://marketeq-backend.onrender.com/api
NEXT_PUBLIC_LISTINGS_URL=https://marketeq-backend.onrender.com/api
NEXT_PUBLIC_WS_URL=wss://marketeq-backend.onrender.com

# --- Auth / session behavior ---
# Staging is HTTPS, so cookies must be SameSite=None; Secure=true.
# Changing these flags is an automatic DEVOPS_SOP §6 violation.
NEXT_PUBLIC_AUTH_MODE=staging
NEXT_PUBLIC_COOKIE_SAMESITE=none
NEXT_PUBLIC_COOKIE_SECURE=true
NEXT_PUBLIC_COOKIE_DOMAIN=.marketeq-staging.com

# --- OAuth callback URLs (staging) ---
NEXT_PUBLIC_GOOGLE_OAUTH_REDIRECT=https://staging.marketeq.com/auth/google/callback
NEXT_PUBLIC_LINKEDIN_OAUTH_REDIRECT=https://staging.marketeq.com/auth/linkedin/callback

# --- Feature flags ---
NEXT_PUBLIC_ENABLE_DEV_LOGIN_BYPASS=false
NEXT_PUBLIC_ENABLE_DEBUG_PANELS=false

# --- E2E backup KEK seed ---
NEXT_PUBLIC_SYSTEM_SECRET=

# --- Storage ---
NEXT_PUBLIC_R2_CDN_BASE=https://cdn.marketeq.com
