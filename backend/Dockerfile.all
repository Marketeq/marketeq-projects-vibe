FROM node:20-alpine AS builder
WORKDIR /app

# Copy everything (workspace structure needed for npm install + nest build)
COPY . .

# Guard against stale incremental metadata during Render rebuilds.
RUN find . -name '*.tsbuildinfo' -delete && rm -rf dist

# Install ALL deps including devDependencies (need @nestjs/cli for build)
RUN npm ci --include=dev --legacy-peer-deps

# Build all 27 backend services.
# Split into separate RUN layers so each gets a fresh Node process
# and Docker can cache successful builds independently.
RUN npx nest build admin-service
RUN npx nest build affiliate-referral-service
RUN npx nest build algolia-service
RUN npx nest build api-gateway
RUN npx nest build auth-service
RUN npx nest build autocomplete-service
RUN npx nest build billing-service
RUN npx nest build category-service
RUN npx nest build checkout-service
RUN npx nest build content-moderation-service
RUN npx nest build contracts-service
RUN npx nest build earnings-service
RUN npx nest build favorites-service
RUN npx nest build invitations-service
RUN npx nest build listings-service
RUN npx nest build messaging-service
RUN npx nest build notification-service
RUN npx nest build payout-service
RUN npx nest build portfolio-service
RUN npx nest build pricing-service
RUN npx nest build search-service
RUN npx nest build suggestions-service
RUN npx nest build time-tracking-service
RUN npx nest build transaction-service
RUN npx nest build user-service
RUN npx nest build wallet-service
RUN npx nest build wire-review-service

# Prune devDependencies for smaller production image
RUN npm prune --production --legacy-peer-deps

# ── Production image ────────────────────────────────────────────────────────
FROM node:20-alpine
WORKDIR /app

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/boot-all.js ./boot-all.js
COPY --from=builder /app/libs/owner-target-grpc/proto ./libs/owner-target-grpc/proto

EXPOSE 10000
CMD ["node", "boot-all.js"]
