# ============================================================================
# Marketeq Backend — PRODUCTION environment template
# ============================================================================
# Per DEVOPS_SOP §5, this template is FROZEN. Changes require a PR
# targeting `live-mvp` with the production four-point login
# confirmation. This template is the schema for the single Render
# service `marketeq-backend`, which auto-deploys on every
# live-mvp push (DEVOPS_SOP §3). Real values are set in Render env
# vars, never committed.
# ============================================================================

NODE_ENV=production
APP_ENV=production
PORT=3002

# --- CORS ---
CORS_ORIGIN=https://marketeq.com
CORS_CREDENTIALS=true
# The gateway reads FRONTEND_URL for both its CORS allow-list and the CSRF
# origin check. It is documented in the local and staging templates but was
# missing here. Hardcoding an origin in code instead is a DEVOPS_SOP §6
# violation, so this variable is the only correct way to set it.
FRONTEND_URL=https://marketeq.com

# --- Cookies ---
COOKIE_DOMAIN=.marketeq.com
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# --- JWT ---
JWT_ISSUER=marketeq
JWT_AUDIENCE=marketeq
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
# The variable the code actually reads is JWT_SECRET — auth-service signs and
# every service verifies with it. Nothing authenticates without it. Set in
# Render env vars; never commit the key material.
JWT_SECRET=

# --- Two-factor ---
# Required by auth-service to encrypt the stored TOTP secret. Without it
# POST /auth/2fa/generate returns 500 and two-factor setup cannot start.
# Set in Render env vars; never commit the key material.
TWO_FACTOR_ENCRYPTION_KEY=

# --- Realtime ---
# Ably, for realtime in-app notification delivery. Without it notifications
# are still stored and appear on the next page load.
ABLY_API_KEY=

# --- Public API base ---
# Builds absolute links in outbound email, notably the notification email
# confirmation link. Without it that link is relative and unusable.
API_PUBLIC_URL=https://marketeq-backend.onrender.com

# --- Database ---
DATABASE_URL=
DATABASE_SSL=false

# --- RabbitMQ ---
RABBITMQ_URL=

# --- Auth transactional email ---
BREVO_API_KEY=
BREVO_FROM_EMAIL=support@marketeqdigital.com
BREVO_FROM_NAME=Marketeq Projects
BREVO_PASSWORD_RESET_TEMPLATE_ID=
BREVO_PASSWORD_CREATED_TEMPLATE_ID=
PASSWORD_CREATED_LOGIN_URL=https://marketeq.com/login

# --- Storage (R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=marketeq-production
R2_CDN_BASE=https://cdn.marketeq.com
