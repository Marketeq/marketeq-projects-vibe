# ============================================================================
# Marketeq Frontend — PRODUCTION environment template
# ============================================================================
# This file is the schema for the Vercel `marketeq-projects-live-mvp`
# project. It tracks the `live-mvp` branch, which is the ONLY branch
# that triggers a Render backend redeploy (per DEVOPS_SOP §3). The
# real values are set in Vercel's dashboard under "Production"
# environment variables.
#
# Per DEVOPS_SOP §5 this template is FROZEN. Changes require a PR
# targeting the `live-mvp` branch with the production four-point
# confirmation in the PR description. Modifying this file does not
# affect local or staging.
# ============================================================================

# --- Backend target ---
# Single Render service `marketeq-vibe-backend` redeployed in lockstep
# with every live-mvp push. Real URL is set in Vercel.
NEXT_PUBLIC_BACKEND_URL=https://marketeq-vibe-backend.onrender.com/api
NEXT_PUBLIC_API_BASE_URL=https://marketeq-vibe-backend.onrender.com/api
NEXT_PUBLIC_WS_URL=wss://marketeq-vibe-backend.onrender.com

# --- Auth / session behavior ---
# Production is HTTPS — cookies must be SameSite=None; Secure=true.
NEXT_PUBLIC_AUTH_MODE=production
NEXT_PUBLIC_COOKIE_SAMESITE=none
NEXT_PUBLIC_COOKIE_SECURE=true
NEXT_PUBLIC_COOKIE_DOMAIN=.marketeq.com

# --- OAuth callback URLs (production) ---
NEXT_PUBLIC_GOOGLE_OAUTH_REDIRECT=https://marketeq.com/auth/google/callback
NEXT_PUBLIC_LINKEDIN_OAUTH_REDIRECT=https://marketeq.com/auth/linkedin/callback

# --- Feature flags ---
NEXT_PUBLIC_ENABLE_DEV_LOGIN_BYPASS=false
NEXT_PUBLIC_ENABLE_DEBUG_PANELS=false

# --- E2E backup KEK seed ---
NEXT_PUBLIC_SYSTEM_SECRET=

# --- Storage ---
NEXT_PUBLIC_R2_CDN_BASE=https://cdn.marketeq.com
