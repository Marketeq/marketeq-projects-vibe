# Database (Supabase PostgreSQL)
# Most services use this single connection string. category-service is
# the exception — it reads discrete DATABASE_HOST/PORT/USERNAME/PASSWORD
# /NAME (see its app.module.ts TypeOrmModule.forRootAsync).
DATABASE_URL=postgres://user:password@host:5432/dbname

# category-service (local dev — different DB from the listings schema)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=category_db
DATABASE_SSL_ENABLED=false

# RabbitMQ
RABBITMQ_URI=amqp://localhost:5672

# JWT
JWT_SECRET=your_jwt_secret_here
AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...paste your key...\n-----END PUBLIC KEY-----"
AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...paste your key...\n-----END PRIVATE KEY-----"
AUTH_JWT_TOKEN_EXPIRES_IN=7d
AUTH_REFRESH_SECRET=your_auth_refresh_secret_here
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d

# Password reset anti-abuse limits (in-memory per auth-service instance)
AUTH_FORGOT_PASSWORD_IP_LIMIT=10
AUTH_FORGOT_PASSWORD_EMAIL_LIMIT=3
AUTH_FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
AUTH_RESET_PASSWORD_IP_LIMIT=20
AUTH_RESET_PASSWORD_RATE_LIMIT_WINDOW_MS=900000

# Internal service auth + routing
INTERNAL_SERVICE_TOKEN=your_internal_service_token_here
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
LISTINGS_SERVICE_URL=http://localhost:3004

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Payout Service — deposit method encryption, OAuth, crypto providers, email
# Encryption keys: generate with `openssl rand -hex 32` — must be 64 hex
# chars. Without a real value, a random key is generated on every process
# restart, making already-encrypted data unreadable after each restart.
BANK_ENCRYPTION_KEY=your_64_char_hex_key_here
OAUTH_TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here
CRYPTO_ADDRESS_ENCRYPTION_KEY=your_64_char_hex_key_here

# PayPal "Log in with PayPal" OAuth (developer.paypal.com > Apps & Credentials)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_REDIRECT_URI=http://localhost:4000/v1/oauth/paypal/callback
# "Log in with PayPal" is identity-only (email/openid). The Payouts API
# authenticates separately with the app's own client_credentials token —
# the paypalhere scope PS-09 §10.1 called out isn't grantable on a standard
# app and causes PayPal to reject the authorize request with "invalid scope".
PAYPAL_SCOPES=openid email

# Wise OAuth (sandbox.transferwise.tech developer account)
WISE_CLIENT_ID=your_wise_client_id
WISE_CLIENT_SECRET=your_wise_client_secret
WISE_REDIRECT_URI=http://localhost:3000/deposit-methods/wise/callback

# Payoneer OAuth (payoneer.com developer program)
PAYONEER_CLIENT_ID=your_payoneer_client_id
PAYONEER_CLIENT_SECRET=your_payoneer_client_secret
PAYONEER_REDIRECT_URI=http://localhost:3000/deposit-methods/payoneer/callback

# SendGrid — magic-link withdrawal confirmation emails. Without a real key
# (or if it starts with "SG.your_"), the verify URL is logged to the
# console instead of being emailed.
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Crypto on/off-ramp providers (only needed if crypto deposit methods matter)
# RAMP_API_KEY doubles as Ramp's "hostApiKey" — a public widget identifier,
# not a server-side secret (Ramp Network has no self-serve server-to-server
# payout API; real credentials come from partner@ramp.network).
RAMP_API_KEY=your_ramp_api_key
RAMP_WEBHOOK_SECRET=your_ramp_webhook_secret
RAMP_WIDGET_BASE=https://app.demo.ramp.network
TRANSAK_API_KEY=your_transak_api_key
CRYPTO_COM_API_KEY=your_crypto_com_api_key
COINBASE_COMMERCE_API_KEY=your_coinbase_commerce_api_key

# Wire transfer
WIRE_ACCOUNT_NAME=Marketeq Digital Inc.
WIRE_BANK_NAME=JP Morgan Chase & Co.
WIRE_BANK_ADDRESS=111 Wall Street New York, New York 10043, United States
WIRE_ACCOUNT_NUMBER=712000528
WIRE_ROUTING_NUMBER=111000523
WIRE_SWIFT_CODE=CHASUS11

# Algolia
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_API_KEY=your_algolia_api_key

# Ably
ABLY_API_KEY=your_ably_api_key

# Cloudflare R2
CLOUDFLARE_R2_ACCESS_KEY=your_r2_access_key
CLOUDFLARE_R2_SECRET_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET=your_bucket_name

# QuickBooks
QUICKBOOKS_CLIENT_ID=your_qb_client_id
QUICKBOOKS_CLIENT_SECRET=your_qb_client_secret

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=your_pinecone_index

# Brevo
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=support@marketeqdigital.com
BREVO_FROM_NAME=Marketeq Projects
BREVO_PASSWORD_RESET_TEMPLATE_ID=
BREVO_PASSWORD_CREATED_TEMPLATE_ID=
BREVO_WITHDRAWAL_TEMPLATE_ID=
PASSWORD_CREATED_LOGIN_URL=http://localhost:3000/login

# E2E Encryption (messaging-service)
# Required — messaging-service will not start without this
E2EE_SERVER_SECRET=your_e2ee_secret_here  # generate with: openssl rand -hex 32

# Node
NODE_ENV=development

FE_ORIGIN=http://localhost:3000
# Required by auth-service to build password-reset links sent via Brevo;
# without it, forgotPassword() silently skips sending the email.
FRONTEND_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
LISTINGS_SERVICE_URL=http://localhost:3004
AUTOCOMPLETE_SERVICE_URL=http://localhost:3016
INVITATIONS_SERVICE_URL=http://localhost:3013
NOTIFICATION_SERVICE_URL=http://localhost:3006
CLIENT_SERVICE_URL=http://localhost:4003

INTERNAL_SERVICE_TOKEN=
DATABASE_URL=postgres://user:password@host:5432/dbname

# ── CMS ↔ listings-service sync ──
# Bearer token the cms-service afterChange hook uses when POSTing to
# listings-service `/internal/project-sync`. Must match the value set
# in backend/apps/cms-service/.env.
CMS_SYNC_TOKEN=
# Payload base URL for listings-service `projectStaticContent` (project details).
# Use the hostname reachable from this process (e.g. `http://cms-service:3020`
# in Docker). Falls back to CMS_SERVICE_URL then localhost:3020.
CMS_PUBLIC_URL=http://localhost:3020
# Optional. Same secret as `CMS_API_KEY` in cms-service — sent as
# `Authorization: API-Key …` so server-side fetches succeed on private networks.
CMS_API_KEY=
# category-service is read by listings-service when enriching
# /v1/projects/:slug with relatedCategories / relatedSkills (spec
# §14.10). Fail-soft — falls back to empty arrays when unreachable.
CATEGORY_SERVICE_URL=http://localhost:3023

# ── LLM adapters (DeliverablesAdapter + SkillsAdapter in listings-service) ──
# Optional. When empty, both adapters run in heuristic fallback mode
# (exact-match dedup for deliverables; tags + category + task titles
# for skills). When set, they call HuggingFace Inference at
# router.huggingface.co/hf-inference/... for embedding + cosine-rank.
# Same pipeline favorites-service uses. See
# backend/apps/listings-service/src/project-sync/{deliverables,skills}/*.
HUGGINGFACE_API_KEY=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Per-adapter model overrides (both fall through to HF_EMBEDDING_MODEL):
# HF_DELIVERABLES_MODEL=
# HF_SKILLS_MODEL=
DELIVERABLES_DEDUP_THRESHOLD=0.88
DELIVERABLES_HF_TIMEOUT_MS=5000
SKILLS_SIMILARITY_THRESHOLD=0.35
SKILLS_TOP_K=10
SKILLS_HF_TIMEOUT_MS=5000
SKILLS_VOCAB_LIMIT=500
SKILLS_VOCAB_TTL_MS=3600000

# Groq (OpenAI-compatible chat completions) — preferred for FAQ + deliverables
# text generation when set; falls through to HUGGINGFACE_API_KEY then the
# heuristic when absent. Only the text-gen adapters use Groq; the skills adapter
# stays on HuggingFace embeddings (Groq has no embeddings API).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
