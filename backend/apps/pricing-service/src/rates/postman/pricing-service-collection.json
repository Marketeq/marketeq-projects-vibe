                { "key": "location", "value": "United+States" },
                { "key": "experience", "value": "mid" }
              ]
            },
            "description": "TC-PG-01. Expects 200. low:7500. median:10000. high:13500. no_data:false."
          }
        },
        {
          "name": "TC-PG-03 — GET Price Guide — no data",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/rates/price-guide?role={{noDataRole}}&location=Antarctica",
