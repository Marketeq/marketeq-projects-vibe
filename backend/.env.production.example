# ============================================================================
# Marketeq Backend — PRODUCTION environment template
# ============================================================================
# Per Code Review SOP §1.10, this template is FROZEN. Changes require a
# PR targeting `main-live` with the production four-point login
# confirmation.
# ============================================================================

NODE_ENV=production
APP_ENV=production
PORT=3002

# --- CORS ---
CORS_ORIGIN=https://marketeq.com
CORS_CREDENTIALS=true

# --- Cookies ---
COOKIE_DOMAIN=.marketeq.com
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# --- JWT ---
JWT_ISSUER=marketeq
JWT_AUDIENCE=marketeq
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# --- Database ---
DATABASE_URL=
DATABASE_SSL=true

# --- RabbitMQ ---
RABBITMQ_URL=

# --- Storage (R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=marketeq-production
R2_CDN_BASE=https://cdn.marketeq.com
