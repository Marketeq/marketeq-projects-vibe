    "description": "Complete test collection for legal-service covering all LS-07 test cases.\n\nAuth strategy: uses x-user-id header (bypasses JWT for local testing).\nRun seed script before executing tests:\n  node dist/apps/legal-service/seeds/run-seed.js\n\nSeed UUIDs:\n  talentA: 11111111-1111-4111-a111-111111111111\n  talentB: 22222222-2222-4222-a222-222222222222\n  clientA: 33333333-3333-4333-a333-333333333333\n  Seed Generated NDA: 44444444-4444-4444-a444-444444444444\n  Seed Voided NDA:    55555555-5555-4555-a555-555555555555",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",          "value": "http://localhost:3015" },
    { "key": "internalSecret",   "value": "test-internal-secret" },
    { "key": "adminToken",       "value": "test-admin-token" },
    { "key": "talentAId",        "value": "11111111-1111-4111-a111-111111111111" },
    { "key": "talentBId",        "value": "22222222-2222-4222-a222-222222222222" },
    { "key": "clientAId",        "value": "33333333-3333-4333-a333-333333333333" },
    { "key": "seedGeneratedNda", "value": "44444444-4444-4444-a444-444444444444" },
    { "key": "seedVoidedNda",    "value": "55555555-5555-4555-a555-555555555555" },
    { "key": "testListingId",    "value": "66666666-6666-4666-a666-666666666666" },
    { "key": "testCompanyId",    "value": "77777777-7777-4777-a777-777777777777" },
