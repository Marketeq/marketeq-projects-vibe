# Deploy to /etc/n8n-alerts.env on the host, chmod 600. Never commit the real file.
# Brevo REST key. Currently returns 401 from this VPS: Brevo's account-level
# Authorised IPs list must include 145.223.126.80 and 2a02:4780:2d:5e4c::1.
# There is no API for that list; add them at app.brevo.com/security/authorised_ips
BREVO_API_KEY=xkeysib-REPLACE_ME
ALERT_FROM=developers@marketeqdigital.com
ALERT_TO=christophertorres17@gmail.com
# ntfy.sh push topic. No account needed. The topic name is the only secret,
# so treat it as one. Subscribe at https://ntfy.sh/<topic>
NTFY_TOPIC=mq-n8n-REPLACE_ME
