                { "key": "role", "value": "{{noDataRole}}" },
                { "key": "location", "value": "Antarctica" }
              ]
            },
            "description": "TC-PG-03. Expects 200. low:null. median:null. high:null. no_data:true."
          }
        },
        {
          "name": "TC-PG-04 — GET Price Guide — stale",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/rates/price-guide?role={{staleRole}}&location=Southeast+Asia&experience=mid",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "rates", "price-guide"],
              "query": [
                { "key": "role", "value": "{{staleRole}}" },
                { "key": "location", "value": "Southeast+Asia" },
                { "key": "experience", "value": "mid" }
              ]
            },
            "description": "TC-PG-04. Flush Redis first. Expects 200. is_stale:true. Values present (not null)."
          }
        },
        {
          "name": "TC-PG-06 — GET Price Guide — missing role param [expect 422]",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/rates/price-guide",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "rates", "price-guide"]
            },
            "description": "TC-PG-06. Expects 422. PS_VALIDATION_ERROR."
          }
        }
      ]
    },
    {
      "name": "Budget",
      "item": [
        {
          "name": "TC-BUD-01 — POST Calculate — single role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roles\": [\n    {\n      \"roleTitle\": \"UX Designer\",\n      \"location\": \"United States\",\n      \"experience\": \"mid\",\n      \"workSchedule\": \"full_time\",\n      \"estimatedHours\": 160\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/budget/calculate",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "budget", "calculate"]
            },
            "description": "TC-BUD-01. Expects 200. breakdown[0].subtotalUsdCents:1600000. totalUsdCents:1600000. has_missing_data:false."
          }
        },
        {
          "name": "TC-BUD-03 — POST Calculate — multiple roles",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roles\": [\n    {\n      \"roleTitle\": \"UX Designer\",\n      \"location\": \"United States\",\n      \"experience\": \"mid\",\n      \"workSchedule\": \"full_time\",\n      \"estimatedHours\": 160\n    },\n    {\n      \"roleTitle\": \"Backend Developer\",\n      \"location\": \"Eastern Europe\",\n      \"experience\": \"senior\",\n      \"workSchedule\": \"full_time\",\n      \"estimatedHours\": 320\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/budget/calculate",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "budget", "calculate"]
            },
            "description": "TC-BUD-03. Expects 200. totalUsdCents:3840000 (1600000 + 2240000). breakdown has 2 entries."
          }
        },
        {
          "name": "TC-BUD-04 — POST Calculate — partial result (one role no data)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roles\": [\n    {\n      \"roleTitle\": \"UX Designer\",\n      \"location\": \"United States\",\n      \"experience\": \"mid\",\n      \"workSchedule\": \"full_time\",\n      \"estimatedHours\": 160\n    },\n    {\n      \"roleTitle\": \"Quantum Architect\",\n      \"location\": \"Antarctica\",\n      \"experience\": \"mid\",\n      \"workSchedule\": \"full_time\",\n      \"estimatedHours\": 80\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/budget/calculate",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "budget", "calculate"]
            },
            "description": "TC-BUD-04. Expects 200. has_missing_data:true. Quantum Architect subtotalUsdCents:null. totalUsdCents = UX Designer subtotal only."
          }
        },
        {
          "name": "TC-BUD-07 — POST Calculate — empty roles array [expect 422]",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roles\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/budget/calculate",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "budget", "calculate"]
            },
            "description": "TC-BUD-07. Expects 422. PS_VALIDATION_ERROR. roles must not be empty."
          }
        },
        {
          "name": "TC-BUD-08 — POST Calculate — estimatedHours below minimum [expect 422]",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roles\": [\n    {\n      \"roleTitle\": \"UX Designer\",\n      \"location\": \"United States\",\n      \"experience\": \"mid\",\n      \"workSchedule\": \"full_time\",\n      \"estimatedHours\": 0\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/budget/calculate",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "budget", "calculate"]
            },
            "description": "TC-BUD-08. Expects 422. PS_VALIDATION_ERROR. estimatedHours Min(1)."
          }
        }
      ]
    },
    {
      "name": "Currency",
      "item": [
        {
          "name": "TC-FX-01 — GET Convert — USD to EUR",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/currency/convert?amount=1000&from=USD&to=EUR",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "currency", "convert"],
              "query": [
                { "key": "amount", "value": "1000" },
                { "key": "from", "value": "USD" },
                { "key": "to", "value": "EUR" }
              ]
            },
            "description": "TC-FX-01. Expects 200. converted = 1000 * cached EUR rate. is_stale:false. from:USD. to:EUR."
          }
        },
        {
          "name": "TC-FX-02 — GET Convert — same currency (USD to USD)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/currency/convert?amount=500&from=USD&to=USD",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "currency", "convert"],
              "query": [
                { "key": "amount", "value": "500" },
                { "key": "from", "value": "USD" },
                { "key": "to", "value": "USD" }
              ]
            },
            "description": "TC-FX-02. Expects 200. converted:500. rate:1. is_stale:false."
          }
        },
        {
          "name": "TC-FX-08 — GET Convert — invalid from code [expect 422]",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/currency/convert?amount=100&from=USDT&to=EUR",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "currency", "convert"],
              "query": [
                { "key": "amount", "value": "100" },
                { "key": "from", "value": "USDT" },
                { "key": "to", "value": "EUR" }
              ]
            },
            "description": "TC-FX-08. Expects 422. PS_VALIDATION_ERROR. from Length(3, 3)."
          }
        },
        {
          "name": "TC-RATES-01 — GET All Rates",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalJwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/currency/rates",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "currency", "rates"]
            },
            "description": "TC-RATES-01. Expects 200. base:USD. rates object contains at least EUR, GBP, CAD. fetched_at is ISO timestamp."
          }
        }
      ]
    },
