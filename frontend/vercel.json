{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "ignoreCommand": "exit 1",
  "git": {
    "deploymentEnabled": {
      "feat/*": false,
      "fix/*": false,
      "chore/*": false,
      "refactor/*": false,
      "agent/*": false,
      "dev-main": true,
      "staging": true,
      "live-mvp": true
    }
  }
}
