# ── CMS Service ──
CMS_PORT=3020
CMS_SERVER_URL=http://cms-service:3020
# Public-facing CMS origin. Used by the syncProjects afterChange hook
# to strip the cms-service host from resolved media URLs so they get
# forwarded as same-origin paths (/cms-media/<file>) that bypass the
# Next.js image optimizer's private-IP SSRF guard in dev.
CMS_PUBLIC_URL=http://localhost:3020

# ── Database (Supabase PostgreSQL) ──
DATABASE_URL=postgresql://user:pass@localhost:5432/marketeq?schema=cms

# ── Payload Secret (32+ chars) ──
PAYLOAD_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING

# ── API Key for service-to-service reads ──
CMS_API_KEY=REPLACE_WITH_SECURE_API_KEY

# ── Category Service ──
# Port 3023 matches category-service/src/main.ts default + ecosystem.config.js.
# In docker-compose the hostname is `category-service`; locally use localhost.
CATEGORY_SERVICE_URL=http://category-service:3023

# ── Sync to listings-service (spec §05 / §07 / §10) ──
# syncProjects afterChange hook POSTs the full Payload document here
# on every publish + DELETE on Payload delete. Must match
# LISTINGS_SERVICE_URL in backend/.env; the bearer token on the
# request must match CMS_SYNC_TOKEN in backend/.env.
LISTINGS_SERVICE_URL=http://listings-service:3004
CMS_SYNC_TOKEN=REPLACE_WITH_SHARED_SYNC_TOKEN

# ── Frontend on-demand ISR ──
# Optional. syncProjects POSTs {secret, paths:['/project-details/<slug>','/projects']}
# so Next.js revalidates the project-details page immediately after
# CMS publish. Leave blank to skip revalidation (page will update on
# the next natural cache expiry).
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=REPLACE_WITH_SHARED_REVALIDATE_SECRET

# ── RabbitMQ ──
RABBITMQ_URL=amqp://user:pass@rabbitmq:5672

# ── Cloudflare R2 Storage ──
# In prod, point R2_ENDPOINT at https://<account-id>.r2.cloudflarestorage.com
# and R2_PUBLIC_URL at the public CDN base, e.g. https://cdn.marketeqdigital.com/marketeq-media.
# In local dev, point at the MinIO container (see backend/apps/cms-service/.env)
# and use a same-origin path (/cms-media) for R2_PUBLIC_URL so the Next.js
# Image Optimizer doesn't trip its private-IP SSRF guard.
R2_BUCKET=marketeq-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.marketeqdigital.com/marketeq-media

# ── First-run admin (remove after first login) ──
# CMS_ADMIN_EMAIL=admin@marketeq.com
# CMS_ADMIN_PASSWORD=change-me

# ── Logging ──
LOG_LEVEL=info
