{
  "name": "marketeq-backend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "shared"
  ],
  "scripts": {
    "start:all": "concurrently \"npm run start -w apps/*\"",
    "dev": "npx pm2 start ecosystem.config.js",
    "dev:stop": "npx pm2 stop all",
    "dev:status": "npx pm2 status",
    "dev:logs": "npx pm2 logs",
    "dev:restart": "npx pm2 restart all",
    "build:all": "npm run build --workspaces --if-present",
    "lint": "eslint \"{apps,shared}/**/*.ts\" --fix",
    "format": "prettier --write \"{apps,shared}/**/*.ts\""
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^29.5.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/superagent": "^8.1.9",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "pm2": "^6.0.14",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.0"
  },
  "overrides": {
    "multer": "^2.1.1",
    "minimatch": "^9.0.7",
    "picomatch": "^4.0.4",
    "tar": "^7.5.13",
    "glob": "^10.5.0",
    "fast-xml-parser": "^5.5.7",
    "flatted": "^3.4.2",
    "handlebars": "^4.7.9",
    "lodash": "^4.18.1"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/microservices": "^10.0.0",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^11.2.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/ua-parser-js": "^0.7.39",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.3",
    "bad-words": "^4.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "geo-tz": "^8.1.6",
    "geoip-lite": "^2.0.1",
    "multer": "^2.1.1",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "sanitize-html": "^2.17.2",
    "sharp": "^0.34.5",
    "ua-parser-js": "^2.0.9"
  }
}
