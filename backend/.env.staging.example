# ============================================================================
# Marketeq Backend — STAGING environment template
# ============================================================================
# Per DEVOPS_SOP §5, this template is FROZEN. Changes require a PR
# targeting `staging` with the staging four-point login confirmation.
# Note: per DEVOPS_SOP §3, the shared Render backend is deployed from
# `live-mvp`, not `staging`. This template documents the staging-facing
# values the shared backend must honor while the staging frontend
# (`marketeq-projects-staging`) talks to the same Render instance as
# production.
# ============================================================================

NODE_ENV=production
APP_ENV=staging
PORT=3002

# --- CORS ---
# Staging frontend (Vercel preview) origin. Must be exact — no wildcards.
CORS_ORIGIN=https://staging.marketeq.com
CORS_CREDENTIALS=true

# FRONTEND_URL — comma-separated trusted origins (same convention as
# auth-service's password-reset flow; payout-service's magic-link email
# uses this the same way). Since marketeq-backend is ONE shared Render
# service serving dev + staging + live at once (DEVOPS_SOP.md §3), the
# REAL value configured on that service already contains the full union of
# all Vercel origins (see scripts/devops/marketeq_orchestrator_node.js's
# RENDER_SHARED_BACKEND_BASELINE) — this template documents staging's own
# contribution to that list, not a value to overwrite it with.
FRONTEND_URL=https://staging.marketeq.com

# --- Cookies ---
# HTTPS production-grade cookies.
COOKIE_DOMAIN=.marketeq-staging.com
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# --- JWT ---
JWT_ISSUER=marketeq-staging
JWT_AUDIENCE=marketeq-staging
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
# The variable the code actually reads is JWT_SECRET — auth-service signs and
# every service verifies with it. Nothing authenticates without it. Set in
# Render env vars; never commit the key material.
JWT_SECRET=

# --- Two-factor ---
# Required by auth-service to encrypt the stored TOTP secret. Without it
# POST /auth/2fa/generate returns 500 and two-factor setup cannot start.
# Set in Render env vars; never commit the key material.
TWO_FACTOR_ENCRYPTION_KEY=

# --- Realtime ---
# Ably, for realtime in-app notification delivery. Without it notifications
# are still stored and appear on the next page load.
ABLY_API_KEY=

# --- Public API base ---
# Builds absolute links in outbound email, notably the notification email
# confirmation link. Without it that link is relative and unusable.
API_PUBLIC_URL=https://marketeq-backend.onrender.com

# --- Database ---
DATABASE_URL=
DATABASE_SSL=false

# --- RabbitMQ ---
RABBITMQ_URL=

# --- Inter-service URLs ---
# payout-service -> earnings-service (fresh balance reads for withdrawals),
# also read by api-gateway's proxy and time-tracking-service's earnings sync.
# NOT the same port as local dev: ecosystem.config.js (local PM2) assigns
# earnings-service:3026/billing-service:3027, but boot-all.js (the shared
# Render service) assigns them the other way around — earnings-service:3027,
# billing-service:3026. Copying the local value here silently points
# payout-service's pre-withdrawal balance read (and the scheduled payout
# engine's balance check) at billing-service instead.
EARNINGS_SERVICE_URL=http://localhost:3027

# --- Auth transactional email ---
BREVO_API_KEY=
BREVO_FROM_EMAIL=support@marketeqdigital.com
BREVO_FROM_NAME=Marketeq Projects
BREVO_PASSWORD_RESET_TEMPLATE_ID=
BREVO_PASSWORD_CREATED_TEMPLATE_ID=
# Optional. With it, Brevo's hosted template is used for the recovery
# email; without it the in-repo layout is used instead.
BREVO_RECOVERY_EMAIL_TEMPLATE_ID=
# https origin mirroring frontend/public/email/ — serves the wordmark in
# transactional emails. Unset or non-https falls back to a text wordmark.
EMAIL_ASSET_BASE_URL=
PASSWORD_CREATED_LOGIN_URL=https://staging.marketeq.com/login

# --- Storage (R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=marketeq-staging
R2_CDN_BASE=https://cdn.marketeq.com

# --- Payments: Stripe ---
# Names only — values live in Render env vars / the marketeq-secrets group.
# Read by billing-service (stripe-subscription.service.ts),
# checkout-service (stripe/stripe.service.ts) and payout-service
# (bank/bank-payout-executor.service.ts, providers/stripe.provider.ts).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Payments: PayPal ---
# Read by payout-service (oauth/oauth.service.ts,
# providers/paypal.provider.ts, paypal/paypal-reconciliation.cron.ts).
# PAYPAL_REDIRECT_URI must exactly match the redirect registered on the
# PayPal app; it is `<backend origin>/v1/oauth/paypal/callback`. When it is
# unset, oauth.service.ts silently defaults it to '' and PayPal OAuth fails
# with no error naming the cause.
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_REDIRECT_URI=
PAYPAL_SCOPES=openid email
PAYPAL_WEBHOOK_ID=
