# ============================================================================
# Marketeq Backend — PRODUCTION environment template
# ============================================================================
# Per DEVOPS_SOP §5, this template is FROZEN. Changes require a PR
# targeting `live-mvp` with the production four-point login
# confirmation. This template is the schema for the single Render
# service `marketeq-backend`, which auto-deploys on every
# live-mvp push (DEVOPS_SOP §3). Real values are set in Render env
# vars, never committed.
# ============================================================================

NODE_ENV=production
APP_ENV=production
PORT=3002

# --- CORS ---
CORS_ORIGIN=https://marketeq.com
CORS_CREDENTIALS=true

# FRONTEND_URL — comma-separated trusted origins (same convention as
# auth-service's password-reset flow; payout-service's magic-link email
# uses this the same way). Since marketeq-backend is ONE shared Render
# service serving dev + staging + live at once (DEVOPS_SOP.md §3), the
# REAL value configured on that service must be the union of all three —
# this template only documents production's own contribution to that list.
FRONTEND_URL=https://marketeq.com

# --- Cookies ---
COOKIE_DOMAIN=.marketeq.com
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# --- JWT ---
JWT_ISSUER=marketeq
JWT_AUDIENCE=marketeq
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# --- Database ---
DATABASE_URL=
DATABASE_SSL=false

# --- RabbitMQ ---
RABBITMQ_URL=

# --- Inter-service URLs ---
# payout-service -> earnings-service (fresh balance reads for withdrawals),
# also read by api-gateway's proxy and time-tracking-service's earnings sync.
# One shared Render service (see DEVOPS_SOP.md §3) — all backend microservices
# run together, so this stays localhost:3026 the same as local dev unless
# earnings-service is ever split into its own Render service.
EARNINGS_SERVICE_URL=http://localhost:3026

# --- Auth transactional email ---
BREVO_API_KEY=
BREVO_FROM_EMAIL=support@marketeqdigital.com
BREVO_FROM_NAME=Marketeq Projects
BREVO_PASSWORD_RESET_TEMPLATE_ID=
BREVO_PASSWORD_CREATED_TEMPLATE_ID=
PASSWORD_CREATED_LOGIN_URL=https://marketeq.com/login

# --- Storage (R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=marketeq-production
R2_CDN_BASE=https://cdn.marketeq.com
