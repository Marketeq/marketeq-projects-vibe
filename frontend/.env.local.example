# ============================================================================
# Marketeq Frontend — LOCAL dev environment template
# ============================================================================
# This file is the ONLY source of truth for env vars on a developer's
# laptop. Copy to `frontend/.env.local` and fill in the blanks.
#
# Per DEVOPS_SOP §5, this template is FROZEN. Changes require a PR
# targeting `dev-main` with the four-point login confirmation from
# SOP §1.4. Modifying this file does not affect staging or production.
#
# DO NOT add Render URLs here. Per DEVOPS_SOP §4, committed local
# templates must run the backend locally (http://localhost:*). A
# developer may point their own machine at Render, but the committed
# template must never do so.
# ============================================================================

# --- Backend target ---
# Local NestJS backend. Boot with: pnpm --filter backend start:dev
NEXT_PUBLIC_BACKEND_URL=http://localhost:3002/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002/api
NEXT_PUBLIC_API_URL=http://localhost:3002/api
NEXT_PUBLIC_AUTH_URL=http://localhost:3002/api
NEXT_PUBLIC_USER_URL=http://localhost:3002/api
NEXT_PUBLIC_LISTINGS_URL=http://localhost:3002/api
NEXT_PUBLIC_WS_URL=http://localhost:3002

# --- Auth / session behavior ---
# Local dev uses SameSite=Lax and Secure=false because localhost is not HTTPS.
# Changing these flags is an automatic DEVOPS_SOP §6 violation.
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_COOKIE_SAMESITE=lax
NEXT_PUBLIC_COOKIE_SECURE=false
NEXT_PUBLIC_COOKIE_DOMAIN=localhost

# --- OAuth callback URLs (local) ---
NEXT_PUBLIC_GOOGLE_OAUTH_REDIRECT=http://localhost:3000/auth/google/callback
NEXT_PUBLIC_LINKEDIN_OAUTH_REDIRECT=http://localhost:3000/auth/linkedin/callback

# --- Feature flags (local defaults) ---
NEXT_PUBLIC_ENABLE_DEV_LOGIN_BYPASS=false
NEXT_PUBLIC_ENABLE_DEBUG_PANELS=true

# --- E2E backup KEK seed ---
# Used for deterministic KEK derivation in key backup/restore.
# Keep this value consistent across environments where recovery is expected.
NEXT_PUBLIC_SYSTEM_SECRET=change-me-in-your-local-env

# --- Storage (Cloudflare R2) — same for all envs, read by signed URL service ---
NEXT_PUBLIC_R2_CDN_BASE=https://cdn.marketeq.com

# --- Cloud file pickers (inbox attachment dropdown) ---
# Provision each vendor once, then fill the matching env var.
# Picker buttons no-op when the relevant var is blank.
# Google Cloud Console → enable Drive API + Picker API → OAuth Web client + API key
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_DRIVE_API_KEY=
# dropbox.com/developers/apps → Scoped access app → Chooser/Saver domains
NEXT_PUBLIC_DROPBOX_APP_KEY=
# Azure Portal → App registration (SPA) → Graph delegated Files.Read
NEXT_PUBLIC_ONEDRIVE_CLIENT_ID=
# --- Time Tracking Service (DTT backend) ---
NEXT_PUBLIC_TTS_URL=http://localhost:3017/api
# --- Earnings Service ---
NEXT_PUBLIC_EARNINGS_SERVICE_URL=http://localhost:3026/v1
NEXT_PUBLIC_PAYOUT_SERVICE_URL=http://localhost:3022/v1