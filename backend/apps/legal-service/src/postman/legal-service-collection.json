  "item": [

    {
      "name": "🏥 Health Check",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
            "pm.test('service name', () => pm.expect(pm.response.json().service).to.eql('legal-service'));"
          ]}}]
        }
      ]
    },

    {
      "name": "📄 NDA Generation",
      "item": [
        {
          "name": "TC-NDA-GEN-01 Generate NDA — individual client [expect 201]",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/nda/generate",
            "header": [
              { "key": "x-internal-api-secret", "value": "{{internalSecret}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"jobListingId\": \"{{testListingId}}\",\n  \"clientUserId\": \"{{clientAId}}\",\n  \"listingTitle\": \"E-commerce Rebuild\",\n  \"displayNameFormat\": \"first_name_username\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('has documentId', () => pm.expect(pm.response.json().documentId).to.be.a('string'));",
            "pm.test('status generated', () => pm.expect(pm.response.json().status).to.eql('generated'));",
