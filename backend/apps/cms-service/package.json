{
  "name": "@marketeq/cms-service",
  "version": "1.0.0",
  "description": "Payload CMS service for Marketeq platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:dev": "npm run bootstrap && ts-node-dev --respawn --transpile-only src/server.ts",
    "bootstrap": "ts-node-dev --transpile-only --no-respawn --exit-child scripts/bootstrap.ts",
    "reset:db": "ts-node-dev --transpile-only --no-respawn --exit-child scripts/reset-db.ts",
    "reset:admin": "ts-node-dev --transpile-only --no-respawn --exit-child scripts/reset-admin.ts",
    "fix:project-lexical": "ts-node-dev --transpile-only --no-respawn --exit-child scripts/fix-project-lexical.ts",
    "backfill:publish-project-fields": "ts-node-dev --transpile-only --no-respawn --exit-child scripts/backfill-publish-project-fields.ts",
    "fix:blog-richtext": "ts-node-dev --transpile-only --no-respawn --exit-child src/scripts/fix-blog-richtext.ts",
    "seed:default-content": "ts-node-dev --transpile-only --no-respawn --exit-child src/seeds/run-default-content-seed.ts",
    "seed:blog-posts": "ts-node-dev --transpile-only --no-respawn --exit-child src/seeds/run-blog-posts-seed.ts",
    "seed:homepage": "ts-node-dev --transpile-only --no-respawn --exit-child src/seeds/run-homepage-seed.ts",
    "seed:projects": "ts-node-dev --transpile-only --no-respawn --exit-child src/seeds/run-projects-seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/lib-storage": "^3.500.0",
    "@payloadcms/bundler-webpack": "^1.0.7",
    "@payloadcms/db-postgres": "^0.8.10",
    "@payloadcms/plugin-cloud-storage": "^1.2.2",
    "@payloadcms/plugin-seo": "^2.4.0",
    "@payloadcms/richtext-lexical": "^0.11.4",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.3",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "payload": "^2.32.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.4",
    "@types/express": "^4.17.21",
    "sass": "^1.99.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
