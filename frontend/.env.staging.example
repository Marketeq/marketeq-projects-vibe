# ============================================================================
# Marketeq Frontend — STAGING environment template
# ============================================================================
# This file is the schema for Vercel Preview deploys pointing at the
# Render staging backend. The real values are set in Vercel's dashboard
# under "Preview / staging" environment variables.
#
# Per Code Review SOP §1.10 this template is FROZEN. Changes require a
# PR targeting the `staging` branch with the staging four-point
# confirmation in the PR description. Modifying this file does not
# affect local or production.
# ============================================================================

# --- Backend target ---
# Render staging backend. Real URL is set in Vercel staging env vars.
NEXT_PUBLIC_BACKEND_URL=https://marketeq-backend-staging.onrender.com/api
NEXT_PUBLIC_API_BASE_URL=https://marketeq-backend-staging.onrender.com/api
NEXT_PUBLIC_WS_URL=wss://marketeq-backend-staging.onrender.com

# --- Auth / session behavior ---
# Staging is HTTPS, so cookies must be SameSite=None; Secure=true.
# Changing these flags is an automatic SOP §1.10 violation.
NEXT_PUBLIC_AUTH_MODE=staging
NEXT_PUBLIC_COOKIE_SAMESITE=none
NEXT_PUBLIC_COOKIE_SECURE=true
NEXT_PUBLIC_COOKIE_DOMAIN=.marketeq-staging.com

# --- OAuth callback URLs (staging) ---
NEXT_PUBLIC_GOOGLE_OAUTH_REDIRECT=https://staging.marketeq.com/auth/google/callback
NEXT_PUBLIC_LINKEDIN_OAUTH_REDIRECT=https://staging.marketeq.com/auth/linkedin/callback

# --- Feature flags ---
NEXT_PUBLIC_ENABLE_DEV_LOGIN_BYPASS=false
NEXT_PUBLIC_ENABLE_DEBUG_PANELS=false

# --- Storage ---
NEXT_PUBLIC_R2_CDN_BASE=https://cdn.marketeq.com
